# TalentX Environment Configuration Example

# Database Connection
DATABASE_URL=postgresql://localhost:5432/talentx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talentx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# NVIDIA NIM API Keys (Round-robin / Fallback across 3 keys)
NVIDIA_NIM_API_KEY_1=your_nvidia_nim_api_key_1_here
NVIDIA_NIM_API_KEY_2=your_nvidia_nim_api_key_2_here
NVIDIA_NIM_API_KEY_3=your_nvidia_nim_api_key_3_here
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# Groq API Keys (Round-robin / Fallback across 2 keys)
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY=your_groq_api_key_fallback_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
UPLOAD_DIR=data/uploads
PII_MASKING_DEFAULT=false
